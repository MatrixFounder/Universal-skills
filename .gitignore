!/.claude/skills/transcript-fetcher
!/.claude/skills/vdd-adversarial
!/.claude/skills/vdd-sarcastic
!/.claude/skills/xlsx

/.claude/commands/*
!/.claude/commands/auto-heal-external-skill.md
!/.claude/commands/generate-detailed-meeting-summary.md

/.claude/agents/

# Local-only Claude Code config + agentic-development CLAUDE.md import
/CLAUDE.local.md
/CLAUDE.agentic.md

# >>> agentic-development framework >>>
